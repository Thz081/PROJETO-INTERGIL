# Copie para .env na VPS e preencha os valores da instalação.
# INTERGIL_VERSAO é o SHA completo da versão publicada no GHCR.
INTERGIL_VERSAO=
INTERGIL_PORT=8086
# Limite de armazenamento do acervo de Momentos, em MiB.
MOMENTOS_ACERVO_MIB=5120
MONGO_URI='mongodb+srv://USUARIO:SENHA_CODIFICADA@HOST_DO_ATLAS/intergil2026?retryWrites=true&w=majority'
# Gere no servidor com openssl rand -hex 48.
JWT_SECRET=
